<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Match the native macOS dark reference: window background, primary-opacity cards,
       secondary text, and mint. SwiftUI's semantic colors can vary with macOS appearance. -->
  <SolidColorBrush x:Key="WindowBrush" Color="#1E1E1E" />
  <SolidColorBrush x:Key="TextBrush" Color="#F4F4F4" />
  <SolidColorBrush x:Key="MutedBrush" Color="#A5A5A5" />
  <SolidColorBrush x:Key="MintBrush" Color="#40F3DF" />
  <SolidColorBrush x:Key="CardBrush" Color="#252525" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#303030" />
  <SolidColorBrush x:Key="WindowBorderBrush" Color="#626262" />
  <SolidColorBrush x:Key="DividerBrush" Color="#363636" />
  <SolidColorBrush x:Key="ButtonBrush" Color="#363636" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#454545" />
  <SolidColorBrush x:Key="HoverBrush" Color="#414141" />
  <SolidColorBrush x:Key="PressedBrush" Color="#4B4B4B" />
  <SolidColorBrush x:Key="SelectedBrush" Color="#70DDCE" />
  <SolidColorBrush x:Key="SelectedTextBrush" Color="#101918" />
  <SolidColorBrush x:Key="SelectedBorderBrush" Color="#70DDCE" />
  <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#3A3020" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFB340" />
</ResourceDictionary>
