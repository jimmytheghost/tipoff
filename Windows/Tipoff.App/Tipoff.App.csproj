<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Tipoff</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Tipoff.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tipoff.Core/Tipoff.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Tipoff.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Tipoff-header.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
