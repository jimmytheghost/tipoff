<Window x:Class="Tipoff.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tipoff" Width="360" SizeToContent="Height" MaxHeight="680"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        FontFamily="Segoe UI" Deactivated="Window_Deactivated">
  <Border Background="#FCFDFC" BorderBrush="#CDD6D3" BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True">
    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.28" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Margin="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Width="30" Height="30" Background="#DDF5ED" CornerRadius="8" Padding="3">
          <Image Source="Tipoff.ico" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" Margin="4,0,0,0">
          <TextBlock Text="Tipoff" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Text="{Binding Tagline}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
        </StackPanel>
      </Grid>

      <Separator Grid.Row="1" Margin="0" />

      <UniformGrid Grid.Row="2" Columns="5" Margin="14,12,14,8">
        <Button x:Name="NbaButton" Content="NBA" Tag="Nba" Click="Guide_Click" Margin="0,0,4,0" />
        <Button x:Name="NflButton" Content="NFL" Tag="Nfl" Click="Guide_Click" Margin="0,0,4,0" />
        <Button x:Name="WnbaButton" Content="WNBA" Tag="Wnba" Click="Guide_Click" Margin="0,0,4,0" />
        <Button x:Name="NhlButton" Content="NHL" Tag="Nhl" Click="Guide_Click" Margin="0,0,4,0" />
        <Button x:Name="MlbButton" Content="MLB" Tag="Mlb" Click="Guide_Click" />
      </UniformGrid>

      <StackPanel Grid.Row="3" Margin="14,0,14,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button Content="‹" FontSize="17" Width="32" Padding="0,2" Click="Previous_Click" ToolTip="Previous day" />
          <StackPanel Grid.Column="1" Margin="10,0">
            <TextBlock Text="{Binding DateTitle}" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="{Binding DateSubtitle}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
          </StackPanel>
          <Button Grid.Column="2" Content="{Binding JumpLabel}" Visibility="{Binding JumpVisibility}" Click="Jump_Click" FontSize="10" Margin="0,0,6,0" />
          <Button Grid.Column="3" Content="›" FontSize="17" Width="32" Padding="0,2" Click="Next_Click" ToolTip="Next day" />
        </Grid>
        <Border Background="#FFF4DE" CornerRadius="6" Padding="8,6" Margin="0,8,0,0" Visibility="{Binding MessageVisibility}">
          <TextBlock Text="{Binding Message}" Foreground="#8A5A00" FontSize="10.5" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <ScrollViewer Grid.Row="4" MaxHeight="430" VerticalScrollBarVisibility="Auto" Margin="14,0">
        <Grid>
          <TextBlock Text="{Binding EmptyMessage}" Visibility="{Binding EmptyVisibility}" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="20,28" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Games}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource CardBrush}" BorderBrush="#DCE5E2" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,8">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding PreferredLabel}" Foreground="{StaticResource MintBrush}" FontWeight="Bold" FontSize="9" />
                        <TextBlock Text="{Binding Away}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding HomeDisplay}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="5,2">
                        <TextBlock Text="{Binding Time}" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text="{Binding Notice}" Foreground="#B46B00" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Margin="4,0,0,0">
                        <TextBlock Text="{Binding BroadcastText}" Foreground="{StaticResource MintBrush}" FontWeight="SemiBold" FontSize="10.5" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                    <Expander Header="{Binding DetailsLabel}" Visibility="{Binding DetailsVisibility}" Margin="0,8,0,0" FontSize="10.5" Foreground="{StaticResource MintBrush}">
                      <Border BorderBrush="#DCE5E2" BorderThickness="0,1,0,0" Margin="0,5,0,0" Padding="0,8,0,0">
                        <StackPanel>
                          <TextBlock Text="ALTITUDE’S LISTINGS" FontWeight="Bold" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                          <TextBlock Text="{Binding DetailsNetworks}" FontWeight="SemiBold" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DetailsTimes}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DetailsNotes}" Foreground="#8A5A00" FontSize="9.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DetailsFreshness}" Foreground="{StaticResource MutedBrush}" FontSize="9.5" Margin="0,5,0,0" />
                        </StackPanel>
                      </Border>
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="5" BorderBrush="#E0E5E3" BorderThickness="0,1,0,0" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Source}" FontWeight="SemiBold" FontSize="10" />
            <TextBlock Text="{Binding Freshness}" Foreground="{Binding FreshnessBrush}" FontSize="10" />
          </StackPanel>
          <Button Grid.Column="1" Content="↻" FontSize="16" Width="32" Padding="0,2" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" ToolTip="Refresh schedule" />
          <Button Grid.Column="2" Content="Quit" Click="Quit_Click" FontSize="10" Margin="6,0,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
